# Secrets — never commit
.env
*.env
!.env.example
# local scratch notes — contains API keys/passwords
Setup.txt

# Copyrighted source material and derived page images — do NOT commit.
# (prototype/ holds one extracted page as a schema reference; see README's License
# section. Keep it to that one.)
*.pdf
data/

# Compiled artifacts — platform-specific, build locally (also avoids embedding
# the builder's absolute paths in the binary)
*.dll

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS / editor cruft
.DS_Store
Thumbs.db
