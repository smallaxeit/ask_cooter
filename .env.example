# Copy to .env and fill in. Loaded automatically for local dev.

# --- API keys (required for ingestion) ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- Database ---
# PostgreSQL 18 runs on port 5433 on this machine (PG17 has 5432). Change if
# you run Postgres elsewhere.
# cooter:cooter is a published default from scripts/bootstrap-db.sql — fine for a
# localhost-only Postgres, not for one reachable from another machine.
DATABASE_URL=postgresql://cooter:cooter@localhost:5433/askcooter

# --- Source PDF + rendered page images ---
PDF_PATH=Softail-1984-1999-Repair-Manual-Harley-Davidson.pdf
IMAGE_DIR=data/pages
RENDER_DPI=150

# --- Models ---
# Vision extraction. claude-opus-5 is the highest quality (and the default);
# claude-sonnet-5 is markedly cheaper for a 651-page run and usually fine for
# OCR-style extraction. Switch here if cost matters more than max fidelity.
EXTRACT_MODEL=claude-opus-5

# Answer synthesis (the `ask` tool + chat UI). Reads retrieved passages and writes
# a direct, cited answer. claude-opus-5 for best quality; claude-sonnet-5 is cheaper.
ANSWER_MODEL=claude-opus-5

# Voyage embedding model + dimension. Keep EMBED_DIM in sync with schema.sql
# (VECTOR(1024)); if you change the dimension, update the DDL too.
VOYAGE_MODEL=voyage-3.5
EMBED_DIM=1024

# --- Retrieval ---
SEARCH_LIMIT=5
